	partition 'observatorio v_cargas' = m
		mode: directQuery
		source =
				let
				    Origen = PostgreSQL.Database("localhost:5432", "observatorio_sismico"),
				    observatorio_v_cargas = Origen{[Schema="observatorio",Item="v_cargas"]}[Data]
				in
