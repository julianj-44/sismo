	partition 'observatorio v_eventos_pais' = m
		mode: directQuery
		source =
				let
				    Origen = PostgreSQL.Database("localhost:5432", "observatorio_sismico"),
				    observatorio_v_eventos_pais = Origen{[Schema="observatorio",Item="v_eventos_pais"]}[Data]
				in
				    observatorio_v_eventos_pais

